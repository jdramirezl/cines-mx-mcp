# Settings for cines-mx-mcp. Copy to ~/.config/cines-mx/cines.env and chmod 600.
# Read by the server at start and by cinesctl. Contains personal data: never commit it.

# A stable Node >= 22.13 (Homebrew or nodejs.org). Version-manager paths
# (nvm, fnm, volta, mise) can vanish on upgrade.
#NODE_BIN=/usr/local/bin/node

# Loopback port for the MCP server (the hub's CINES_MCP_URL must match).
#CINES_MCP_PORT=8686

# --- Automatic Cinépolis login (e-mail code) ---
# Your Cinépolis account e-mail (the one that receives the 6-digit code).
#CINES_LOGIN_EMAIL=you@example.com
# The DEDICATED bot mailbox that receives only forwarded Cinépolis mail.
#CINES_IMAP_USER=bot-mailbox@example.com
# Its Gmail app password is read from the Keychain (service cines-mx-imap);
# only if you cannot use the Keychain, put it here instead:
#CINES_IMAP_PASSWORD=
# Substring of the code e-mail's From address (default "cinepolis").
#CINES_CODE_SENDER=cinepolis

# --- Purchases ---
# Lower the per-purchase cap (MXN). Values above 1000 are ignored.
#CINES_PURCHASE_CAP_MXN=1000
