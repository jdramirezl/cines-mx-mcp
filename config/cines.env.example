# Optional overrides for cinesctl and the LaunchAgents. Copy to
# ~/.config/cines-mx/cines.env (chmod 600). Not secret, but keep it private.

# A stable Node >= 22.13 (Homebrew or nodejs.org). Version-manager paths
# (nvm, fnm, volta, mise) can vanish on upgrade.
#NODE_BIN=/usr/local/bin/node

# Loopback port for the MCP server (the hub's CINES_MCP_URL must match).
#CINES_MCP_PORT=8686
