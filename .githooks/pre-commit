#!/usr/bin/env bash
# Refuse commits that contain secrets or personal data.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#staged[@]}" -eq 0 ] && exit 0
exec npx --no-install tsx scripts/check-secrets.ts "${staged[@]}"
