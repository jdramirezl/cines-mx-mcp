{
  "name": "cines-mx-mcp",
  "version": "0.1.0",
  "description": "Personal MCP server for Mexican cinema chains (Cinépolis first): listings, showtimes, seats and tickets.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "cines": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "redact": "tsx scripts/redact-har.ts",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check-secrets",
    "prepush": "npm run check",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
